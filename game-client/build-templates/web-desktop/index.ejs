  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
  <title>RUC物语 · 中关村教学区</title>
  <style>
    html, body { width: 100%; height: 100%; margin: 0; overflow: hidden; background: #29392c; }
